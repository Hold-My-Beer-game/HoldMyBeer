:root {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(77, 77, 77);
    text-shadow: 2px 2px 10px rgb(26, 26, 26);
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/ShadowsIntoLight-Regular.ttf?fileID=12800000&guid=cfa71ea6a352f0f4fbfb917a1934840e&type=3#ShadowsIntoLight-Regular");
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.bullet {
    flex-grow: 0;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/shotshell.png?fileID=21300000&guid=926aaba88be6ec14e87b922d55a3a054&type=3#shotshell");
    flex-shrink: 1;
    background-repeat: space no-repeat;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    rotate: -20deg;
}

#GameTitle {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Butcherman-Regular.ttf?fileID=12800000&guid=6cee90d00cf06594fa86a9689cb0d43b&type=3#Butcherman-Regular");
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 130px;
    word-spacing: 30px;
    color: rgb(255, 99, 71);
    -unity-text-outline-color: rgba(128, 121, 24, 0.67);
    text-shadow: 2px 3px 10px rgb(79, 128, 0);
    padding-left: 2%;
    flex-wrap: wrap;
    flex-shrink: 0;
    height: 30%;
    -unity-text-align: lower-left;
    letter-spacing: 10px;
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
    -unity-text-outline-width: 2px;
    -unity-font-style: normal;
}

.main-menu-btn {
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 45px;
    transition-duration: 0.05s;
    transition-timing-function: ease;
}

.main-menu-btn:enabled:hover {
    -unity-font-style: bold;
    letter-spacing: 15px;
    -unity-text-outline-width: 2px;
}

.main-menu-btn:active {
    color: rgba(204, 255, 144, 0.8);
}

#btn-NewGame {
    font-size: 69px;
}

#btn-NewGame:enabled:hover {
    background-image: none;
    -unity-background-image-tint-color: rgb(139, 0, 0);
}

#settings-group .unity-group-box__label {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 70px;
    flex-grow: 0;
    -unity-text-align: upper-left;
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: left 0;
    border-left-color: rgb(95, 119, 67);
    border-right-color: rgb(95, 119, 67);
    border-top-color: rgb(95, 119, 67);
    border-bottom-color: rgb(95, 119, 67);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 0;
}

#settings-group > .unity-group-box__label {
    -unity-text-align: upper-center;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#settings-group #unity-tracker {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/brushstrokes.png?fileID=-855683453&guid=e86200c0137799148ba02cbeea4efd75&type=3#brushstrokes_1");
    border-left-color: rgb(95, 119, 67);
    border-right-color: rgb(95, 119, 67);
    border-top-color: rgb(95, 119, 67);
    border-bottom-color: rgb(95, 119, 67);
    -unity-background-image-tint-color: rgb(95, 119, 67);
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    scale: 1 3;
}

#settings-group #unity-dragger {
    border-left-color: rgba(0, 0, 0, 0.36);
    border-right-color: rgba(0, 0, 0, 0.36);
    border-top-color: rgba(0, 0, 0, 0.36);
    border-bottom-color: rgba(0, 0, 0, 0.36);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/bottle.png?fileID=21300000&guid=4b6748682197e7c47831d515089ae743&type=3#bottle");
    background-color: rgba(0, 0, 0, 0);
    scale: 3 3;
    rotate: 30deg;
}

#settings-group .unity-slider__label {
    width: 25%;
    color: rgb(241, 241, 241);
}

#settings-group .unity-slider__label:focus {
    width: 25%;
    color: rgb(255, 0, 0);
}

.pause-menu-btn {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    -unity-text-align: middle-center;
    flex-grow: 1;
    font-size: 40px;
    flex-shrink: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
    letter-spacing: 0;
    transition-duration: 0.05s;
}

.pause-menu-btn:enabled:hover {
    letter-spacing: 6px;
}

.pause-menu-btn:active {
    -unity-text-outline-color: rgb(95, 119, 67);
    letter-spacing: 0;
    text-shadow: 0 1px 0 rgb(95, 119, 67);
}

#endgame-menu > TemplateContainer {
    flex-grow: 0;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
    padding-left: 0%;
    height: 35%;
}

#settings-exit-btn {
    align-self: flex-end;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/icon_ban.png?fileID=21300000&guid=9976ab3c9a146a048b7fe54650a61eac&type=3#icon_ban");
    height: 6%;
    aspect-ratio: 1;
    -unity-background-image-tint-color: rgb(150, 188, 106);
}

#settings-exit-btn:hover {
    scale: 1.05 1.05;
    transition-duration: 0.1s;
    opacity: 0.8;
}

#settings-exit-btn:active {
    opacity: 0.7;
}

#quality-radio-group #choicesContentContainer {
    flex-direction: row;
    justify-content: space-around;
}

#bg > #settings-group > #graphic-settings-group > #quality-radio-group > .unity-base-field__label {
    width: 25%;
}

#settings-group #unity-drag-container {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 1;
}

.template-container {
    position: absolute;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.menu-exit-btn {
    align-self: flex-end;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/icon_ban.png?fileID=21300000&guid=9976ab3c9a146a048b7fe54650a61eac&type=3#icon_ban");
    height: 6%;
    aspect-ratio: 1;
    -unity-background-image-tint-color: rgb(150, 188, 106);
}

.menu-exit-btn:hover {
    scale: 1.05 1.05;
    transition-duration: 0.1s;
    opacity: 0.8;
}

.menu-exit-btn:active {
    opacity: 0.7;
}



.credits-title {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Butcherman-Regular.ttf?fileID=12800000&guid=6cee90d00cf06594fa86a9689cb0d43b&type=3#Butcherman-Regular");
    -unity-font-style: bold;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-auto-size: none;
    font-size: 110px;
    text-shadow: 3px 3px 0 rgb(149, 180, 95);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(61, 61, 61);
}

.credits-header {
    flex-wrap: wrap;
    -unity-text-auto-size: none;
    -unity-text-generator: advanced;
    flex-grow: 0;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Butcherman-Regular.ttf?fileID=12800000&guid=6cee90d00cf06594fa86a9689cb0d43b&type=3#Butcherman-Regular");
    -unity-font-style: normal;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 69px;
    color: rgb(203, 255, 144);
    text-shadow: 2px 2px 0 rgb(243, 255, 0);
}

.credits-element {
    font-size: 44px;
    -unity-text-outline-width: 0;
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(136, 255, 0);
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 51px;
    text-shadow: 0 0 0 rgb(93, 93, 93);
}
