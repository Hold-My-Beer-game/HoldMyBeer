:root {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(77, 77, 77);
    text-shadow: 2px 2px 10px rgb(26, 26, 26);
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/LondrinaSolid-Regular.ttf?fileID=12800000&guid=bb70a4f1f80082444870beed0827ac7f&type=3#LondrinaSolid-Regular");
    letter-spacing: 5px;
}

.bullet {
    flex-grow: 0;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/shotshell.png?fileID=21300000&guid=926aaba88be6ec14e87b922d55a3a054&type=3#shotshell");
    flex-shrink: 1;
    background-repeat: space no-repeat;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    rotate: -20deg;
}

#GameTitle {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Butcherman-Regular.ttf?fileID=12800000&guid=6cee90d00cf06594fa86a9689cb0d43b&type=3#Butcherman-Regular");
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 115px;
    word-spacing: 30px;
    color: rgb(255, 99, 71);
    -unity-text-outline-color: rgb(128, 24, 24);
    text-shadow: 2px 3px 10px rgb(33, 0, 0);
    padding-left: 2%;
    flex-wrap: wrap;
    flex-shrink: 0;
    height: 30%;
    -unity-text-align: lower-left;
    letter-spacing: 10px;
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
}

.main-menu-btn {
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 45px;
    transition-duration: 0.02s;
    transition-timing-function: ease;
}

.main-menu-btn:enabled:hover {
    -unity-font-style: bold;
    letter-spacing: 15px;
    -unity-text-outline-width: 2px;
}

.main-menu-btn:active {
    color: rgba(255, 255, 255, 0.78);
}

#btn-NewGame {
    font-size: 69px;
}

#btn-NewGame:enabled:hover {
    background-image: none;
    -unity-background-image-tint-color: rgb(139, 0, 0);
}

#settings-group .unity-group-box__label {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 70px;
}

#settings-group > .unity-group-box__label {
    -unity-text-align: upper-center;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
}

#settings-group #unity-tracker {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI%20Toolkit/Sprites/brushstrokes.png?fileID=-855683453&guid=e86200c0137799148ba02cbeea4efd75&type=3#brushstrokes_1");
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(193, 18, 31);
}

#settings-group .unity-slider__label {
    width: 25%;
    color: rgb(255, 255, 255);
}

.pause-menu-btn {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    -unity-text-align: middle-center;
    flex-grow: 1;
    font-size: 40px;
    flex-shrink: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
    letter-spacing: 0;
}

.pause-menu-btn:enabled:hover {
    letter-spacing: 6px;
}

.pause-menu-btn:active {
    -unity-text-outline-color: rgb(255, 0, 0);
}

#endgame-menu > TemplateContainer {
    flex-grow: 0;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
    padding-left: 0%;
    height: 35%;
}
