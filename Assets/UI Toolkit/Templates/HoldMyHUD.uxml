            <ui:Image name="Shotgun" style="height: 100%; width: 20%; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Sprites/shotgun.png?fileID=21300000&amp;guid=6c86d550386f23044b9e4b2dc537a5d5&amp;type=3#shotgun&quot;); -unity-background-scale-mode: scale-and-crop;"/>
