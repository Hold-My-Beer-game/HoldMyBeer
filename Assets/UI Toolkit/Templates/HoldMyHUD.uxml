    <ui:Label text="CONTROLS&#10;&#10;Camera: [Mouse]&#10;Shoot/Reload: [Left Click]&#10;Movement: [WASD] &#10;Crouch: [C]&#10;Pause Game: [Tab]" name="ControlsLabel" style="position: absolute; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Sprites/battle_end_bg.png?fileID=21300000&amp;guid=bf92ab47995e16544817ecf36c63b342&amp;type=3#battle_end_bg&quot;); -unity-background-image-tint-color: rgb(0, 0, 0); -unity-text-align: upper-left; -unity-background-scale-mode: scale-to-fit; background-color: rgba(13, 13, 13, 0); -unity-text-generator: advanced; -unity-text-auto-size: best-fit 10px 50px; width: 100%; height: 100%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 10%; padding-right: 0%; padding-bottom: 10%; padding-left: 5%; display: flex; background-position-y: top 0; background-position-x: left 0; justify-content: flex-end;">
